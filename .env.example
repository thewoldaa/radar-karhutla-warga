# ============================================================================
# Radar Karhutla Warga — contoh variabel lingkungan
# Salin menjadi .env.local untuk pengembangan (JANGAN di-commit).
# Di produksi (Firebase App Hosting): set lewat Cloud Secret Manager +
# referensi `secret:` di apphosting.yaml.
#
# ATURAN: nilai RAHASIA tidak boleh berprefix NEXT_PUBLIC_ (akan bocor ke klien).
# ============================================================================

# --- Titik panas: NASA FIRMS (Fase 1) ----------------------------------------
# Daftar MAP_KEY gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# RAHASIA — URL FIRMS memuat key ini; panggil HANYA dari server.
FIRMS_MAP_KEY=

# Daftar sumber titik panas (dipisah koma). Jangan hardcode di kode.
# Catatan: produk S-NPP berhenti 2 Nov 2026 -> NOAA-20/21 sebagai tulang punggung.
FIRMS_SOURCES=VIIRS_NOAA21_NRT,VIIRS_NOAA20_NRT

# Bbox Indonesia (urutan: west,south,east,north).
# [VERIFIKASI] bbox usulan 95,-11,141,6 belum dicek terhadap extent resmi FIRMS.
FIRMS_BBOX=95,-11,141,6

# --- Kualitas udara: OpenAQ (stasiun) (Fase 2) -------------------------------
# Daftar key gratis: https://explore.openaq.org/register
# RAHASIA — panggil HANYA dari server (CORS diblokir; wajib proxy server).
OPENAQ_API_KEY=

# --- Kualitas udara: Open-Meteo (model) (Fase 2) -----------------------------
# Free tier NON-KOMERSIAL. Begitu iklan/sponsor aktif, wajib langganan.
# Jika sudah berlangganan, isi OPEN_METEO_API_KEY dan pakai endpoint
# customer-api.open-meteo.com (lihat docs Open-Meteo).
OPEN_METEO_API_KEY=

# --- Supabase -----------------------------------------------------------------
# URL & publishable key AMAN untuk klien (dipakai browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAHASIA — server-only. Jangan pernah berprefix NEXT_PUBLIC_.
# (Kunci legacy `service_role` deprecated akhir 2026; pakai sb_secret_...)
SUPABASE_SECRET_KEY=

# --- Anti-abuse (Fase 3) -------------------------------------------------------
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret server untuk HMAC (device & IP). Acak minimal 32 byte, dirotasi berkala.
DEVICE_HASH_SECRET=
IP_HASH_SECRET=

# --- Ingest terjadwal -----------------------------------------------------------
# Pilih SALAH SATU jalur (atau keduanya):
#
# (A) GitHub Actions cron — DEFAULT proyek ini.
#     String acak minimal 32 byte; nilai yang SAMA dipasang sebagai secret
#     INGEST_HMAC_SECRET di repo GitHub (Settings → Secrets → Actions).
#     Rahasia: jangan pernah berprefix NEXT_PUBLIC_.
INGEST_HMAC_SECRET=
#
# (B) Cloud Scheduler + OIDC (opsional, untuk self-host di GCP).
#     Endpoint memverifikasi token: signature (JWKS), issuer, audience, email SA.
#     Lihat: https://docs.cloud.google.com/scheduler/docs/http-target-auth
# Contoh INGEST_AUDIENCE:
#   https://<backend-id>--<project-id>.asia-southeast1.hosted.app/api/ingest
INGEST_AUDIENCE=
INGEST_SA_EMAIL=

# --- Peta (Fase 1) -------------------------------------------------------------
# Default: OpenFreeMap (gratis, komersial diizinkan, tanpa API key).
# Cadangan: Thunderforest / CARTO (lihat docs/03-IKLAN.md).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# --- Iklan (Fase 4) ------------------------------------------------------------
# AdSense: isi setelah situs disetujui. Kosong = slot jaringan nonaktif.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Kontak pemilik untuk slot sponsor (tampil di /pasang-iklan).
NEXT_PUBLIC_AD_CONTACT_EMAIL=

# --- Mode pengembangan ----------------------------------------------------------
# 'true' hanya di pengembangan: menampilkan data contoh berlabel "DATA CONTOH".
# WAJIB 'false' (atau kosong) di produksi — data contoh dilarang tampil di produksi.
NEXT_PUBLIC_DEMO_MODE=false
